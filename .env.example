# Logo Error Checker — environment configuration
# Copy this file to `.env` and fill in your values. Never commit `.env`.

# Telegram bot token from @BotFather (required to run app/bot/telegram_bot.py).
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here

# Yandex Disk OAuth token used by the bot to archive accepted photos.
# Leave empty if you are not using the Yandex Disk upload feature.
YANDEX_DISK_TOKEN=your-yandex-disk-oauth-token-here
